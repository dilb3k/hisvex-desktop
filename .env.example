# Base URL for the comp-bar-server API, including the /api prefix.
# Production (default in .env): https://hisvex-api-production.up.railway.app/api
# Local backend: http://localhost:<port>/api
VITE_API_BASE_URL=https://hisvex-api-production.up.railway.app/api

# Backup backend (comp-bar-server deployed a second time on Render, same
# MongoDB Atlas cluster as primary). The client fails over to this
# automatically on a 502/503/504 or connection failure and switches back
# once primary's own /health answers again — see src/api/client.ts.
VITE_API_BACKUP_URL=https://hisvex-api.onrender.com/api
